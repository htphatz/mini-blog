{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./mvnw test:*)",
      "Bash(./mvnw clean test:*)",
      "Bash(./mvnw compile:*)",
      "Bash(./mvnw clean package:*)",
      "Bash(./mvnw -v)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(docker-compose ps:*)",
      "Bash(docker-compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(./mvnw dependency:tree:*)",
      "Bash(git ls-files:*)",
      "Bash(docker ps:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/application-*.yml)",
      "Read(./**/application-*.properties)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(cat .env:*)",
      "Bash(git push --force:*)",
      "Read(./**/firebase-service-account.json)",
      "Edit(./.env)",
      "Edit(./**/.env)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(docker-compose down:*)",
      "Bash(docker compose down:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)",
      "Bash(rm:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-edit.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/compile-service.sh\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}